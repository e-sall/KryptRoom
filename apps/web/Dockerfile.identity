FROM node:22.23.5-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee AS build
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm install --global npm@10.9.10 --ignore-scripts --registry=https://registry.npmjs.org
RUN test "$(npm --version)" = "10.9.10" && npm ci --ignore-scripts --strict-peer-deps --no-audit
COPY src ./src
COPY public ./public
COPY next.config.ts tsconfig.json next-env.d.ts postcss.config.mjs ./
RUN npm run build

# Trusted acceptance controller only; never used by the API or BFF runtime.
FROM mcr.microsoft.com/playwright:v1.64.1-noble@sha256:2f05f8a734509a7b3f26a912639488ee08f58a7b292d14d62271bcff9038768f AS acceptance
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/.next ./.next
COPY package.json package-lock.json playwright.identity.config.ts ./
COPY tests-identity ./tests-identity
COPY tests-rooms-real ./tests-rooms-real
COPY playwright.rooms.config.ts ./
COPY playwright.config.ts playwright.identity-regression.config.ts ./
COPY tests ./tests
COPY tsconfig.json vitest.config.ts eslint.config.mjs ./
COPY --from=build /app/next-env.d.ts ./
COPY src ./src
ENV CI=1 HOME=/run/browser-tmp TMPDIR=/run/browser-tmp
USER 10001:10001
CMD ["node", "node_modules/@playwright/test/cli.js", "test", "-c", "playwright.identity.config.ts", "--output=/run/browser-tmp/test-results"]

FROM node:22.23.5-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee AS runtime
ENV NEXT_TELEMETRY_DISABLED=1 NODE_ENV=production HOSTNAME=127.0.0.1 PORT=3004
WORKDIR /app
# Production server.js does not need the bundled package-manager attack surface.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack
COPY --from=build --chown=10001:10001 /app/.next/standalone ./
COPY --from=build --chown=10001:10001 /app/.next/static ./.next/static
COPY --from=build --chown=10001:10001 /app/public ./public
USER 10001:10001
CMD ["node", "server.js"]
