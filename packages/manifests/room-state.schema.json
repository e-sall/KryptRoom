{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kryptroom.dev/schemas/room-state.schema.json",
  "title": "KryptRoom RoomState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "roomId",
    "parentStateIds",
    "artifacts",
    "transition",
    "policy",
    "cryptoContext",
    "commitment"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": { "$ref": "#/$defs/id" },
    "roomId": { "$ref": "#/$defs/id" },
    "parentStateIds": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifactRef" }
    },
    "transition": { "$ref": "#/$defs/stateTransition" },
    "policy": { "$ref": "#/$defs/statePolicy" },
    "cryptoContext": { "$ref": "#/$defs/cryptoContext" },
    "commitment": { "$ref": "#/$defs/stateCommitment" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "ciphertextRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["party", "uri", "sha256", "sizeBytes"],
      "properties": {
        "party": { "$ref": "#/$defs/id" },
        "uri": { "type": "string", "pattern": "^local://" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "mediaType",
        "visibility",
        "cryptoContextId",
        "shape",
        "dtype",
        "includesIdentifiers",
        "ciphertexts"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["spu-secret-share", "openfhe-ciphertext"] },
        "mediaType": {
          "enum": [
            "application/vnd.kryptroom.spu-share+encrypted",
            "application/vnd.kryptroom.openfhe-ciphertext"
          ]
        },
        "visibility": { "enum": ["secret-shared", "encrypted"] },
        "protection": { "const": "fhe_ciphertext" },
        "cryptoContextId": { "$ref": "#/$defs/id" },
        "shape": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "dtype": { "type": "string" },
        "includesIdentifiers": { "const": false },
        "ciphertexts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/ciphertextRef" }
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "spu-secret-share" },
            "mediaType": { "const": "application/vnd.kryptroom.spu-share+encrypted" },
            "visibility": { "const": "secret-shared" },
            "ciphertexts": { "minItems": 2, "maxItems": 2 }
          },
          "not": { "required": ["protection"] }
        },
        {
          "required": ["protection"],
          "properties": {
            "kind": { "const": "openfhe-ciphertext" },
            "mediaType": { "const": "application/vnd.kryptroom.openfhe-ciphertext" },
            "visibility": { "const": "encrypted" },
            "protection": { "const": "fhe_ciphertext" },
            "ciphertexts": { "minItems": 1, "maxItems": 1 }
          }
        }
      ]
    },
    "stateTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operation",
        "parentStateIds",
        "inputJobId",
        "outputArtifactIds",
        "effectiveAt"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "operation": { "type": "string" },
        "parentStateIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "inputJobId": { "$ref": "#/$defs/id" },
        "outputArtifactIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "effectiveAt": { "type": "string", "format": "date-time" }
        ,"bindings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cohortCardinality": {"type": "integer", "minimum": 0},
            "operator": {"enum": ["private_analytics", "private_nn_training", "private_model_evaluation", "fhe_vector_encrypt", "fhe_vector_add"]},
            "request": {"type": "object"},
            "outputStateId": {"$ref": "#/$defs/id"},
            "outputArtifactCommitments": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
            "transitionCommitment": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          },
          "oneOf": [
            {"required": ["cohortCardinality"], "maxProperties": 1},
            {"required": ["operator", "request", "outputStateId", "outputArtifactCommitments", "transitionCommitment"], "maxProperties": 5}
          ]
        }
      }
    },
    "authorizedReveal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "recipients"],
      "properties": {
        "name": { "type": "string" },
        "recipients": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        }
      }
    },
    "statePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultReveal",
        "plaintextMaterialization",
        "matchedIdentifierReveal",
        "futureIdentifierDisclosure",
        "authorizedReveals"
      ],
      "properties": {
        "defaultReveal": { "const": "deny" },
        "allowedOperators": {"type": "array", "uniqueItems": true, "items": {"enum": ["private_analytics", "private_nn_training", "private_model_evaluation", "fhe_vector_add"]}},
        "allowedInputArtifactIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "plaintextMaterialization": { "const": "forbidden" },
        "matchedIdentifierReveal": { "const": "forbidden" },
        "futureIdentifierDisclosure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requiresExplicitOptIn"],
          "properties": {
            "requiresExplicitOptIn": { "const": true }
          }
        },
        "authorizedReveals": {
          "type": "array",
          "items": { "$ref": "#/$defs/authorizedReveal" }
        }
      }
    },
    "cryptoContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "backend",
        "backendVersion",
        "protocol",
        "field",
        "securityModel",
        "participants",
        "artifactCipher",
        "keyScope"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "backend": { "type": "string" },
        "backendVersion": { "type": "string" },
        "protocol": { "type": "string" },
        "field": { "type": "string" },
        "securityModel": { "enum": ["semi-honest", "HEStd_128_classic"] },
        "participants": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "artifactCipher": { "enum": ["AES-256-GCM", "OpenFHE-BGV-ciphertext"] },
        "keyScope": { "enum": ["per-kryptnode-local", "single-owner-node-local"] },
        "keyEpoch": { "$ref": "#/$defs/id" },
        "keyOwner": { "$ref": "#/$defs/id" },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plaintextModulus", "multiplicativeDepth", "batchSize", "securityLevel", "ringDimension", "serialization", "operationSet"],
          "properties": {
            "plaintextModulus": { "type": "integer", "minimum": 2 },
            "multiplicativeDepth": { "type": "integer", "minimum": 0 },
            "batchSize": { "type": "integer", "minimum": 1 },
            "securityLevel": { "type": "string" },
            "ringDimension": { "type": "integer", "minimum": 1 },
            "serialization": { "const": "BINARY" },
            "operationSet": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          }
        },
        "publicMaterialRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/publicMaterialRef" }
        },
        "evaluationMaterialRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/publicMaterialRef" }
        }
      }
    },
    "publicMaterialRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "uri", "sha256", "sizeBytes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["crypto-context", "public-key", "evaluation-key"] },
        "uri": { "type": "string", "pattern": "^local://" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "stateCommitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "value"],
      "properties": {
        "algorithm": { "const": "SHA-256" },
        "canonicalization": { "const": "json-sort-keys-v1" },
        "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}